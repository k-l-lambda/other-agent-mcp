# Subagent MCP Configuration
# Copy this file to .env and fill in your values

# Provider: 'openai' or 'anthropic'
SUBAGENT_PROVIDER=openai

# API base URL (leave empty for official OpenAI/Anthropic)
# Examples:
#   Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek: https://api.deepseek.com/v1
#   Ollama: http://localhost:11434/v1
SUBAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Your API key (required)
SUBAGENT_API_KEY=sk-your-api-key-here

# Default model ID
SUBAGENT_MODEL=qwen-max

# Model registry (optional)
# Simple format - map names to model IDs:
#   {"fast":"qwen-turbo","smart":"qwen-max"}
#
# Full format - override provider per model:
#   {"qwen":{"provider":"openai","modelId":"qwen-max","baseUrl":"https://..."},"local":{"provider":"openai","modelId":"llama3","baseUrl":"http://localhost:11434/v1"}}
SUBAGENT_MODELS={"qwen-max":"qwen-max","qwen-turbo":"qwen-turbo","qwen-plus":"qwen-plus"}
